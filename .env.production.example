APP_NAME=EadControl
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-cursos.incluireeducar.com.br
FRONTEND_URL=https://cursos.incluireeducar.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo
LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=eadcontrol
DB_USERNAME=eadcontrol
DB_PASSWORD=strong-password

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PERSISTENT=true

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.incluireeducar.com.br

SANCTUM_STATEFUL_DOMAINS=cursos.incluireeducar.com.br,api-cursos.incluireeducar.com.br

FILESYSTEM_DISK=public
VITE_TENANT_API_URL=https://api-cursos.incluireeducar.com.br

RECAPTCHA_SECRET=

# Evolution GO — conexões WhatsApp e inbox (fallback global; por tenant use Integrações)
EVOLUTION_GO_URL=
EVOLUTION_GO_API_KEY=
EVOLUTION_GO_INSTANCE_PREFIX=ead
EVOLUTION_GO_MAX_INSTANCES=5
# URL pública desta API para o Evolution GO entregar webhooks (ex.: túnel ngrok/cloudflared).
EVOLUTION_GO_WEBHOOK_BASE_URL=

# Provedores de IA (fallback global; por tenant use Integrações)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
AI_DEFAULT_PROVIDER=openai
AI_EMBEDDING_PROVIDER=openai

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=nao_responda@incluireeducar.com.br
MAIL_FROM_NAME="${APP_NAME}"
